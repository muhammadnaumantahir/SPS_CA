{"cells":[{"cell_type":"markdown","metadata":{},"source":["# SPS-CA Colab\n","\n","Concise runner for the current `main` repository. It keeps the existing Ollama + public Web UI setup and evaluates the **pre-generated** `evaluation/scenarios/growth_1000.json` suite without generating new scenarios."]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# ============================================================\n","# CELL 1 — SPS-CA COLAB: ENVIRONMENT + OLLAMA MODEL FIRST\n","# ============================================================\n","\n","import os\n","import subprocess\n","import sys\n","import time\n","from pathlib import Path\n","\n","#MODEL = \"qwen2.5-coder:7b\"\n","MODEL = \"qwen3-coder:30b\"\n","\n","def run(cmd, check=True, cwd=None, env=None):\n","    print(f\"\\n$ {cmd}\")\n","    result = subprocess.run(cmd, shell=True, text=True, stdout=subprocess.PIPE,\n","                            stderr=subprocess.STDOUT, cwd=cwd, env=env)\n","    print(result.stdout)\n","    if check and result.returncode != 0:\n","        raise RuntimeError(f\"Command failed ({result.returncode}): {cmd}\\n{result.stdout}\")\n","    return result\n","\n","print(\"=\" * 70)\n","print(\"SPS-CA COLAB ENVIRONMENT SETUP\")\n","print(\"=\" * 70)\n","\n","run(\"apt-get update -qq\")\n","run(\"apt-get install -y -qq git curl zstd\")\n","run(f\"{sys.executable} -m pip install -q --upgrade pip\")\n","run(f'{sys.executable} -m pip install -q \"pyngrok\" \"pytest\" \"pytest-json-report\"')\n","\n","ollama_check = subprocess.run(\"command -v ollama\", shell=True, capture_output=True, text=True)\n","if ollama_check.returncode != 0:\n","    run(\"curl -fsSL https://ollama.com/install.sh | sh\")\n","run(\"ollama --version\")\n","\n","subprocess.run(\"pkill -f 'ollama serve' 2>/dev/null || true\", shell=True)\n","subprocess.Popen([\"ollama\", \"serve\"], stdout=open(\"/tmp/ollama.log\", \"w\"), stderr=subprocess.STDOUT)\n","\n","ollama_ready = False\n","for _ in range(30):\n","    time.sleep(1)\n","    health = subprocess.run(\"curl -s http://127.0.0.1:11434/api/tags\", shell=True,\n","                            capture_output=True, text=True)\n","    if health.returncode == 0:\n","        ollama_ready = True\n","        break\n","if not ollama_ready:\n","    print(open(\"/tmp/ollama.log\").read()[-5000:])\n","    raise RuntimeError(\"Ollama service did not become ready.\")\n","\n","print(\"✓ Ollama service is ready\")\n","print(f\"\\nPulling required model: {MODEL}\")\n","run(f\"ollama pull {MODEL}\")\n","run(\"ollama list\")\n","print(\"\\nCELL 1 PASSED\")"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# ============================================================\n","# CELL 2 — PULL CANONICAL MAIN + INSTALL PROJECT REQUIREMENTS\n","# ============================================================\n","\n","import os\n","import shutil\n","import subprocess\n","import sys\n","from pathlib import Path\n","\n","REPO = Path(\"/content/SPS_CA\")\n","REMOTE_URL = \"https://github.com/muhammadnaumantahir/SPS_CA.git\"\n","BRANCH = \"main\"\n","\n","if REPO.exists():\n","    shutil.rmtree(REPO)\n","\n","subprocess.run([\n","    \"git\", \"clone\", \"--branch\", BRANCH, \"--single-branch\", REMOTE_URL, str(REPO)\n,"], check=True)\nos.chdir(REPO)\n\nsubprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"-r\", str(REPO / \"requirements.txt\")], check=True)\n\nprint(\"=\" * 70)\nprint(\"REPOSITORY READY\")\nprint(\"=\" * 70)\nprint(subprocess.check_output([\"git\", \"rev-parse\", \"--short\", \"HEAD\"], text=True).strip())\nprint(\"✓ Canonical main pulled\")\nprint(\"✓ Repository synchronized\")\nprint(\"✓ requirements.txt installed\")"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# ============================================================\n","# CELL 3 — CORE IMPORT SMOKE CHECK\n","# ============================================================\n","\n","import os\n","import sys\n","\n","REPO = \"/content/SPS_CA\"\n","os.chdir(REPO)\n","if REPO not in sys.path:\n","    sys.path.insert(0, REPO)\n","\n","from layers.architecture import architecture_manifest\n","from brain import Brain\n","from core.canonical_sps_pipeline import CanonicalSPSPipeline\n","from layers.layer_08_evolution_core import GrowthDecisionEngine\n","\n","manifest = architecture_manifest()\n","assert len(manifest[\"layers\"]) == 10\n","assert manifest[\"brain\"][\"name\"] == \"SPS-CA Brain\"\n","\n","print(\"✓ Ten canonical SPS layers available\")\n","print(\"✓ Brain boundary available\")\n","print(\"✓ Canonical pipeline import available\")\n","print(\"✓ Layer 8 growth decision engine available\")"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# ============================================================\n","# CELL 4 — SPS-CA WEB UI (UNCHANGED FLOW)\n","# ============================================================\n","\n","import os\n","import subprocess\n","import sys\n","import time\n","from getpass import getpass\n","\n","REPO = \"/content/SPS_CA\"\n","PORT = 5000\n","os.chdir(REPO)\n","\n","subprocess.run(\"pkill -f 'ui.web_app' 2>/dev/null || true\", shell=True)\n","server_log = open(\"/tmp/sps_ca_web_ui.log\", \"w\")\n","server = subprocess.Popen([sys.executable, \"-m\", \"ui.web_app\"], cwd=REPO,\n","                          stdout=server_log, stderr=subprocess.STDOUT)\n","time.sleep(2)\n","\n","from pyngrok import ngrok\n","\n","token = os.environ.get(\"NGROK_AUTHTOKEN\")\n","if not token:\n","    try:\n","        token = getpass(\"Enter NGROK_AUTHTOKEN (leave blank for local-only UI): \" ).strip()\n","    except Exception:\n","        token = \"\"\n","\n","if token:\n","    ngrok.set_auth_token(token)\n","    public_tunnel = ngrok.connect(PORT, \"http\")\n","    print(f\"SPS-CA public Web UI: {public_tunnel.public_url}\")\n","else:\n","    print(f\"SPS-CA local Web UI: http://127.0.0.1:{PORT}\")\n","\n","print(\"✓ Web UI started\")\n","print(\"✓ Ollama remains available on http://127.0.0.1:11434\")"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# ============================================================\n","# CELL 5 — TEST THE EXISTING 1000 SCENARIOS (NO GENERATION)\n","# ============================================================\n","\n","import json\n","import subprocess\n","import sys\n","from pathlib import Path\n","\n","REPO = Path(\"/content/SPS_CA\")\n","SCENARIO_FILE = REPO / \"evaluation/scenarios/growth_1000.json\"\n","REPORT_FILE = Path(\"/content/sps_ca_1000_test_report.json\")\n","\n","if not SCENARIO_FILE.exists():\n","    raise FileNotFoundError(f\"Pre-generated scenario suite not found: {SCENARIO_FILE}\")\n","\n","# Import validation helpers only; do NOT call the scenario generator.\n","from scripts.evaluate_growth_scenarios import load, validate_structure, validate_routing, validate_evolution_contracts\n","\n","scenarios = load()\n","validate_structure(scenarios)\n","validate_routing(scenarios)\n","validate_evolution_contracts(scenarios)\n","\n","pytest_targets = [\n","    \"layers/layer_08_evolution_core/tests/test_growth_decision_scoring.py\",\n","    \"layers/layer_08_evolution_core/tests/test_capability_improvement.py\",\n","]\n","pytest_result = subprocess.run([sys.executable, \"-m\", \"pytest\", *pytest_targets, \"-q\"],\n","                               cwd=REPO, text=True, capture_output=True)\n","print(pytest_result.stdout)\n","if pytest_result.returncode != 0:\n","    print(pytest_result.stderr)\n","    raise RuntimeError(\"Targeted evolution tests failed.\")\n","\n","breakdown = {}\n","for scenario in scenarios:\n","    key = scenario[\"scenario_type\"]\n","    breakdown[key] = breakdown.get(key, 0) + 1\n","\n","report = {\n","    \"status\": \"PASS\",\n","    \"scenario_file\": str(SCENARIO_FILE),\n","    \"total\": len(scenarios),\n","    \"breakdown\": breakdown,\n","    \"generation_called\": False,\n","    \"targeted_evolution_tests\": \"PASS\",\n","}\n","REPORT_FILE.write_text(json.dumps(report, indent=2) + \"\\n\", encoding=\"utf-8\")\n","\n","print(\"=\" * 70)\n","print(\"1000-SCENARIO TEST COMPLETE\")\n","print(\"=\" * 70)\n","print(f\"Total: {report['total']}\")\n","print(f\"Capability routing: {breakdown.get('capability_routing', 0)}\")\n","print(f\"Autonomous evolution: {breakdown.get('autonomous_evolution', 0)}\")\n","print(f\"Evolution proof: {breakdown.get('evolution_proof', 0)}\")\n","print(\"✓ Existing scenario file tested\")\n","print(\"✓ No scenario generation called\")\n","print(\"✓ Targeted scoring/improvement tests passed\")"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# ============================================================\n","# CELL 6 — REPORT RESULTS\n","# ============================================================\n","\n","import json\n","from pathlib import Path\n","\n","REPORT_FILE = Path(\"/content/sps_ca_1000_test_report.json\")\n","if not REPORT_FILE.exists():\n","    raise FileNotFoundError(\"Run CELL 5 first; no test report was found.\")\n","\n","report = json.loads(REPORT_FILE.read_text(encoding=\"utf-8\"))\n","breakdown = report[\"breakdown\"]\n","\n","print(\"=\" * 70)\n","print(\"SPS-CA 1000-SCENARIO REPORT\")\n","print(\"=\" * 70)\n","print(f\"Overall: {report['status']}\")\n","print(f\"Total scenarios: {report['total']}/1000\")\n","print(f\"Capability routing: {breakdown.get('capability_routing', 0)}/490\")\n","print(f\"Autonomous evolution: {breakdown.get('autonomous_evolution', 0)}/500\")\n","print(f\"Evolution proof: {breakdown.get('evolution_proof', 0)}/10\")\n","print(f\"Scenario generation called: {report['generation_called']}\")\n","print(f\"Targeted scoring/improvement tests: {report['targeted_evolution_tests']}\")\n","print(\"=\" * 70)\n"]}],"metadata":{"colab":{"name":"sps_ca_colab.ipynb","provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3","language":"python"},"language_info":{"name":"python","version":"3.11"}},"nbformat":4,"nbformat_minor":5}