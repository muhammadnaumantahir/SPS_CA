# SPS-CA Specific Ignores

# Runtime logs and temporary files
experience/logs/*.json
governance/decisions/*.json
evaluation/scenarios/*.json
evaluation/sandbox/*.json
evaluation/regression/*.json
evaluation/rollback/*.json
evaluation/metrics/*.json
ui/session_history.json

# NOTE: capabilities/generated/*/ is intentionally NOT ignored (unlike the
# runtime-log ignores above). Generated capabilities are Layer 8's actual
# research artifact -- versioned, tested Python modules committed with an
# "EVOLUTION: ..." message (Phase 4) -- not regenerable runtime output.

# Target projects (will be created during Phase 8)
projects/project_a_python/
projects/project_b_java/
projects/project_c_typescript/

# Ollama model files (large, not needed in repo)
*.bin
*.model

# Local LLM inference cache
.ollama/
llm_cache/

# Docker build artifacts
.docker/

# Temporary test data
*.tmp
*.test
test_output/

